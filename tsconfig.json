{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/out-tsc",
    "baseUrl": ".",
    "paths": {
      "@app-core/*": ["src/app/core/*"],
      "@kyc/shared": ["../frontend-libs/shared/src/public-api.ts"],
      "@kyc/shared/*": ["../frontend-libs/shared/src/lib/*"],
      "@kyc/layout": ["../frontend-libs/layout/src/public-api.ts"],
      "@kyc/layout/*": ["../frontend-libs/layout/src/lib/*"],
      "@kyc/auth": ["../frontend-libs/auth/src/public-api.ts"],
      "@kyc/auth/*": ["../frontend-libs/auth/src/lib/*"],
      "@kyc/api-common": ["../frontend-libs/api-common/src/public-api.ts"],
      "@kyc/api-common/*": ["../frontend-libs/api-common/src/lib/*"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
